# MIRAGE environment template. Copy to .env and fill values. Never commit .env.

# --- Required in production (API + dashboard reads) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key
MIRAGE_API_TOKEN=replace-with-random-token

# --- Evidence chain (required to sign/verify; fail-closed without it) ---
MIRAGE_EVIDENCE_HMAC_KEY=replace-with-random-hmac-key

# --- Optional: browser realtime status (public, anon key only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# --- Optional: hybrid LLM layer (deterministic heuristic fallback if unset) ---
MIRAGE_LLM_PROVIDER=none            # openai | anthropic | auto | none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: opt-in middleware / guards (truthy enables) ---
MIRAGE_SCAN_MIDDLEWARE=
MIRAGE_AGENT_GUARD=

# --- Optional: RAG guard thresholds (low | medium | high | critical) ---
MIRAGE_RAG_BLOCK=critical
MIRAGE_RAG_QUARANTINE=medium

# --- Optional: MCP gateway policy ---
MIRAGE_MCP_MAX_RISK=critical
MIRAGE_MCP_ALLOW_SERVERS=
MIRAGE_MCP_DENY_SERVERS=
MIRAGE_MCP_ALLOW_TOOLS=
